# /etc/agentforge/agentforge.env on the GCE VM (mode 600, owner agentforge). Read by all three systemd units.

# Runtime data on the VM's local persistent disk: snapshot, checkpoints, run ownership, logs, tunnel address.
AGENTFORGE_HOME=/var/lib/agentforge

# TACC gateway (the vLLM job's address is read from USERDIR over SSH).
TACC_SSH=<tacc user>@gw.turing.ust.hk
TACC_SSH_PORT=30041
TACC_SSH_KEY=/etc/agentforge/tacc_key
TACC_REMOTE_USERDIR=/mnt/home/<tacc user>/USERDIR

# Knowledge snapshot in GCS (deploy/gcp/publish-snapshot.sh prints this line). Checked against the SHA256 pinned
# in configs/knowledge.json before it is installed.
KNOWLEDGE_SEED_URL=gs://<bucket>/snapshots/snapshot_5bcd00723fb0b7589cbe50c8.zip

# How the backend knows a request came from the Pages Function: a random secret, the same value as the Pages
# secret PROXY_SECRET (openssl rand -hex 32). With only this set, the page is public: anyone may use it, limits
# count per visitor IP.
AGENTFORGE_PROXY_SECRET=<64 hex characters>

# Optional sign-in with Cloudflare Access (README, last section). Leave commented out for a public page.
# CF_ACCESS_TEAM_DOMAIN=<team>.cloudflareaccess.com
# CF_ACCESS_USER_AUD=<audience tag of the Access application on the page>
# Own domain with Cloudflare Tunnel instead of a proxy secret:
# CF_ACCESS_API_AUD=<audience tag of the Access application on api.<domain>>

# Live web search (SerpApi Google Shopping), optional. Without keys the agent only has the catalog, as in the evaluation.
# Several keys (comma-separated) are used in turn, and a key that is used up is skipped. SERPAPI_DAILY_LIMIT caps the
# searches per day across all keys (default 30; the count is kept in $AGENTFORGE_HOME/live-search-count.json).
# SERPAPI_API_KEYS=<key1>,<key2>
# SERPAPI_DAILY_LIMIT=30
